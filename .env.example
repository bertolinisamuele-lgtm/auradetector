# =============================================================================
# AuraDetector — environment configuration (copy to .env and fill in)
# Nothing here is ever shipped to the browser.
#
# Default setup is 100% free: Google Gemini API, Free Tier, no billing account,
# no credit card. AuraDetector never retries on quota exhaustion and has no paid
# fallback anywhere in the code path.
# =============================================================================

# --- Server -------------------------------------------------------------------
PORT=8787
NODE_ENV=production

# --- AI provider (free) -------------------------------------------------------
# Gemini is the default and the only production provider.
AI_PROVIDER=gemini

# Google Gemini API key — server-side ONLY.
# Get it for free: https://aistudio.google.com/apikey  (no credit card required)
# In CREAO this is stored as the secret AURADETECTOR_GEMINI.
# (GEMINI_API_KEY is accepted as a fallback name on other hosts.)
AURADETECTOR_GEMINI=

# Optional: pin a specific free-tier Flash model. Leave empty / "auto" to let
# the server auto-select the newest Flash model your key can use.
# Only Flash-family models are used, so a free key can never trigger a bill.
GEMINI_MODEL=auto

# --- Gemini free-tier protection ---------------------------------------------
# Hard caps enforced BEFORE calling Gemini, so the free tier is never exceeded
# and no billable request can ever be made. Tune to match your free-tier quota.
# Free-tier daily quotas reset at midnight Pacific time.
GEMINI_FREE_DAILY_LIMIT=900
GEMINI_FREE_PER_MINUTE=8

# --- Per-visitor limits -------------------------------------------------------
# Free scans per anonymous visitor per day (server-enforced).
FREE_SCANS_PER_DAY=1
# Hard cap of analyse calls per IP per hour (abuse protection).
ANALYZE_PER_HOUR=20

# --- App / storage ------------------------------------------------------------
# Public origin used for OAuth redirects and Stripe return URLs.
APP_ORIGIN=http://localhost:8787
# Directory for the SQLite database (use PostgreSQL in production).
DATA_DIR=./data

# --- Accounts: Google OAuth ---------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI:  <APP_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Accounts: Apple Sign in --------------------------------------------------
# Apple Developer → Certificates, Identifiers & Profiles → Services ID + Key (.p8).
# Authorised redirect URI:  <APP_ORIGIN>/api/auth/apple/callback
APPLE_CLIENT_ID=            # the Services ID (e.g. app.auradetector.web)
APPLE_TEAM_ID=              # 10-char Team ID
APPLE_KEY_ID=               # Key ID of the .p8 key
APPLE_PRIVATE_KEY=          # contents of the .p8 file, with \n line breaks

# --- Accounts: limits ---------------------------------------------------------
# Requests per 15 minutes per IP on /api/auth/* (brute-force protection).
AUTH_PER_15MIN=40

# --- Stripe subscriptions -----------------------------------------------------
# Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_or_test_...
# Stripe Dashboard → Developers → Webhooks → add endpoint:
#   <APP_ORIGIN>/api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.created/updated/deleted,
#         invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe Dashboard → Products → recurring Prices (monthly + yearly)
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# --- Admin --------------------------------------------------------------------
# Required (min 8 chars). Store a strong passphrase, not a guessable word.
ADMIN_PASSCODE=
# Required (min 16 chars). Long random string, e.g. `openssl rand -hex 32`.
ADMIN_SESSION_SECRET=

# --- Sessions / cookies -------------------------------------------------------
# Signing secret for cookies (min 16 chars).
SESSION_SECRET=
# Force Secure cookies (defaults to true when NODE_ENV=production).
COOKIE_SECURE=true

# --- CORS (optional) ----------------------------------------------------------
# Leave empty when the PWA is served from the same origin (recommended).
ALLOWED_ORIGINS=

# --- Pricing (optional seed, editable from the admin dashboard) ---------------
PRICE_MONTHLY=6.99
PRICE_YEARLY=39.99

# =============================================================================
# The following are OPTIONAL and OFF by default. AuraDetector does not use them
# unless you explicitly set AI_PROVIDER to a paid provider.
# =============================================================================
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=

# Deterministic test provider (NOT AI). Only for automated tests.
ALLOW_MOCK_AI=false
